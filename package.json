{
  "name": "angel-scatman-portfolio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "vite --config apps/web/vite.config.ts --port=3000 --host=0.0.0.0",
    "dev:cms": "npm run dev -w @portfolio/cms",
    "build": "vite build --config apps/web/vite.config.ts",
    "build:cms": "npm run build -w @portfolio/cms",
    "generate:importmap:cms": "npm run generate:importmap -w @portfolio/cms",
    "migrate:cms": "npm run migrate -w @portfolio/cms",
    "migrate:create:cms": "npm run migrate:create -w @portfolio/cms",
    "preview": "vite preview --config apps/web/vite.config.ts",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && tsc --noEmit"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/dompurify": "^3.0.5",
    "@vitejs/plugin-react": "^5.0.4",
    "date-fns": "^4.4.0",
    "dompurify": "^3.4.12",
    "front-matter": "^4.0.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.1",
    "sileo": "^0.1.5",
    "vite": "^6.2.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "eslint": "^10.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^6.2.3"
  }
}
