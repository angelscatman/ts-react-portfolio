HOST_PORT=8080
PUBLIC_NETWORK_NAME=public_network

# Payload CMS
CMS_PORT=3001
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3001
PAYLOAD_SECRET=change-me-in-production

# Postgres
POSTGRES_DB=portfolio_cms
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=change-me

# Required when running the CMS outside Docker. Docker Compose injects this automatically.
DATABASE_URI=postgres://portfolio:change-me@localhost:5432/portfolio_cms